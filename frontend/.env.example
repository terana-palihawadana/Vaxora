# Local development: leave unset to use the Vite proxy (/api → local API)
# Deployed web: set to your API origin (no trailing /api)
# VITE_API_URL=https://your-api-host.example

# Playwright (npm run test:e2e): put these in frontend/.env.e2e, which is git-ignored.
# Use the passwords the API seeded the test accounts with (TestSeed__* and AdminSeed__*).
# PATIENT_PASSWORD=
# HOSPITAL_PASSWORD=
# ADMIN_PASSWORD=

